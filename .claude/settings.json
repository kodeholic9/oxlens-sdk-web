{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/repository/context/spec/tools/hooks/spec_guard.py\" --regen-read"
          }
        ]
      }
    ]
  }
}
