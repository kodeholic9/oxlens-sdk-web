#!/bin/sh
# author: kodeholic (powered by Claude)
# SDK 를 바꾼 push 는 그 커밋의 3층 통과 기록(.archive/gate-live/latest.json)이 있어야 나간다(마스터 §시험 체계).
top=$(git rev-parse --show-toplevel)
rec="$top/.archive/gate-live/latest.json"
zero=0000000000000000000000000000000000000000
need=0
while read lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha^!"; else range="$rsha..$lsha"; fi
  git diff --name-only $range -- src qa scripts package.json 2>/dev/null | grep -q . && need=1
done
[ "$need" = 0 ] && exit 0
head=$(git rev-parse --short=12 HEAD)
python3 - "$rec" "$head" <<'PY'
import json, sys
path, head = sys.argv[1], sys.argv[2]
try:
    r = json.load(open(path))
except Exception:
    print(f"✗ push 거절 — 3층 기록이 없다: {path}\n  `OXE2E_HUB=… npm run gate:live` 를 이 커밋으로 돌린다")
    sys.exit(1)
if not r.get("passed") or r.get("sdk_sha") != head or r.get("sdk_dirty"):
    print(f"✗ push 거절 — 이 커밋({head})의 3층 통과 기록이 아니다: passed={r.get('passed')} sdk={r.get('sdk_sha')} dirty={r.get('sdk_dirty')} at={r.get('at')}")
    sys.exit(1)
print(f"✓ 3층 통과 기록 확인 — sdk {head} · server {r.get('server_build')} · {r.get('at')}")
PY
