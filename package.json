{
  "name": "@oxlens/sdk",
  "version": "1.0.0-alpha.0",
  "description": "OxLens web client SDK — push-to-talk and video conferencing over the OxLens SFU. Contract: oxlens-sfu docs/protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "arch": "node tools/arch_check.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "node test/run.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:live": "node scripts/gate.mjs --live",
    "serve:lan": "node qa/lan/serve.mjs"
  },
  "license": "Apache-2.0",
  "author": "Tae Goo Kang <kodeholic99@gmail.com>",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.4.0"
  }
}
